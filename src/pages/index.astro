		<meta property="og:description" content={SITE.description} />
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&display=swap"
			rel="stylesheet"
		/>
		<link rel="preload" as="image" href="/img/hero.webp" media="(min-width: 768px)" fetchpriority="high" />
		<link rel="preload" as="image" href="/img/hero-m.webp" media="(max-width: 767px)" fetchpriority="high" />
		<script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

		{/* ---------- Tracking (chỉ chèn khi đã khai báo ID trong config) ---------- */}
		{
			TRACKING.gtmId && (
				<script
					is:inline
					set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${TRACKING.gtmId}');`}
				/>
			)
		}
		{
			TRACKING.gtagId && (
				<>
					<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${TRACKING.gtagId}`} />
					<script
						is:inline
						set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${TRACKING.gtagId}');`}
					/>
				</>
			)
		}
		{
			TRACKING.metaPixelId && (
				<script
					is:inline
					set:html={`!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init','${TRACKING.metaPixelId}');fbq('track','PageView');`}
				/>
			)
		}
		{
			TRACKING.tiktokPixelId && (
				<script
					is:inline
					set:html={`!function(w,d,t){w.TiktokAnalyticsObject=t;var ttq=w[t]=w[t]||[];ttq.methods=["page","track","identify","instances","debug","on","off","once","ready","alias","group","enableCookie","disableCookie"];ttq.setAndDefer=function(t,e){t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}};for(var i=0;i<ttq.methods.length;i++)ttq.setAndDefer(ttq,ttq.methods[i]);ttq.load=function(e,n){var i="https://analytics.tiktok.com/i18n/pixel/events.js";ttq._i=ttq._i||{};ttq._i[e]=[];ttq._i[e]._u=i;ttq._t=ttq._t||{};ttq._t[e]=+new Date;ttq._o=ttq._o||{};ttq._o[e]=n||{};var o=d.createElement("script");o.type="text/javascript";o.async=!0;o.src=i+"?sdkid="+e+"&lib="+t;var a=d.getElementsByTagName("script")[0];a.parentNode.insertBefore(o,a)};ttq.load('${TRACKING.tiktokPixelId}');ttq.page();}(window,document,'ttq');`}
				/>
			)
		}
	</head>

	<body>
		<a class="skip" href="#dang-ky">Đến form đăng ký</a>

		<!-- ================= HEADER ================= -->
		<header class="hd" id="top">
			<div class="wrap hd__in">
				<a href="#top" class="hd__logo" aria-label="TT GENESIS">
					<img src="/img/logo-white.png" alt="TT GENESIS" width="156" height="40" />
				</a>
				<nav class="hd__nav" aria-label="Điều hướng">
					<a href="#uu-dai">Ưu đãi</a>
					<a href="#vi-tri">Vị trí</a>
					<a href="#tien-ich">Tiện ích</a>
					<a href="#can-ho">Căn hộ</a>
					<a href="#thanh-toan">Thanh toán</a>
					<a href="#phap-ly">Pháp lý</a>
					<a href="#faq">Hỏi đáp</a>
				</nav>
				<a href={telHref} class="btn btn--gold hd__call" data-track="call_header">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg>
					<span>{CONTACT.phoneDisplay}</span>
				</a>
			</div>
		</header>

		<main>
			<!-- ================= HERO ================= -->
			<section class="hero">
				<picture class="hero__bg">
					<source media="(max-width: 767px)" srcset="/img/hero-m.webp" />
					<img src="/img/hero.webp" alt="Phối cảnh hai tháp Maris và Lucis của TT GENESIS bên sông lúc hoàng hôn" width="2000" height="968" fetchpriority="high" />
				</picture>
				<div class="wrap hero__in">
					<div class="hero__copy">
						<p class="eyebrow">Liên doanh Việt Nam · Nhật Bản · Singapore</p>
						<h1>
							<span class="h1__small">Căn hộ</span>
							Tri thức <em>Nhật Bản</em>
							<span class="h1__sub">tại Nam Sài Gòn – liền kề Phú Mỹ Hưng</span>
						</h1>
						<div class="hero__price">
							<div class="pricebox">
								<span class="pricebox__k">Giá chỉ từ</span>
								<span class="pricebox__v">69<small> triệu/m²</small></span>
							</div>
							<div class="pricebox">
								<span class="pricebox__k">Thanh toán cố định · không vay</span>
								<span class="pricebox__v">29<small> triệu/tháng</small></span>
							</div>
						</div>
						<p class="hero__note">Đơn giá theo phương thức thanh toán chuẩn, diện tích tim tường, chưa gồm VAT. Thanh toán cố định áp dụng theo phương thức “Dễ sở hữu 2”.</p>
						<ul class="hero__ticks">
							<li>88 tiện ích Compound Resort trên 1,9 ha</li>
							<li>Sổ hồng sở hữu lâu dài · VPBank bảo lãnh</li>
							<li data-expires="2026-10-06T23:59:59+07:00">Chiết khấu 1% cho khách đăng ký sớm đến 06/10/2026 (*)</li>
							<li data-show-after="2026-10-06T23:59:59+07:00" hidden>Chính sách thanh toán linh hoạt, đến 8% chiết khấu</li>
						</ul>
						<div class="hero__cta">
							<a href="#dang-ky" class="btn btn--gold btn--lg" data-track="cta_hero">Nhận bảng giá & chính sách</a>
							<a href={zaloHref} target="_blank" rel="noopener" class="btn btn--ghost btn--lg" data-track="zalo_hero">Chat Zalo tư vấn</a>
						</div>
					</div>
					<div class="hero__form">
						<LeadForm id="hero" compact title="Nhận bảng giá Đợt 1" subtitle="Miễn phí, không ràng buộc. Bạn chọn cách nhận – qua Zalo hoặc điện thoại." cta="Gửi tôi bảng giá" />
					</div>
				</div>
			</section>

			<!-- ================= STATS ================= -->
			<section class="stats" aria-label="Tổng quan dự án">
				<div class="wrap stats__grid">
					{stats.map((s) => (
						<div class="stat">
							<strong>{s.v}</strong>
							<span>{s.l}</span>
						</div>
					))}
				</div>
			</section>

			<!-- ================= OFFERS ================= -->
			<section class="sec sec--dark" id="uu-dai">
				<div class="wrap">
					<header class="sec__hd">
						<p class="eyebrow">Chính sách bán hàng Đợt 1</p>
						<h2>Ưu đãi dành cho <em>khách hàng tiên phong</em></h2>
						<p class="lead">Chính sách bán hàng Đợt 1 do chủ đầu tư ban hành. Ưu đãi chiết khấu 1% cho khách đăng ký sớm kết thúc sau:</p>
						<div class="countdown" data-deadline="2026-10-06T23:59:59+07:00" aria-live="off">
							<div><b data-cd="d">--</b><span>ngày</span></div>
							<div><b data-cd="h">--</b><span>giờ</span></div>
							<div><b data-cd="m">--</b><span>phút</span></div>
							<div><b data-cd="s">--</b><span>giây</span></div>
						</div>
					</header>
					<div class="offers">
						{offers.map((o) => (
							<article class="offer" data-expires={o.expires}>
								{o.tag && <span class="offer__tag">{o.tag}</span>}
								<div class="offer__big">{o.big}{o.unit && <small>{o.unit}</small>}</div>
								<h3>{o.title}</h3>
								<p>{o.text}</p>
							</article>
						))}
					</div>
					<p class="fine">(*) Chi tiết theo thông báo chính sách bán hàng do chủ đầu tư ban hành tại từng thời điểm. Các chính sách có thể không áp dụng đồng thời.</p>
					<div class="center">
						<a href="#dang-ky" class="btn btn--gold btn--lg" data-track="cta_offers">Nhận chi tiết chính sách Đợt 1</a>
					</div>
				</div>
			</section>

			<!-- ================= STRENGTHS ================= -->
			<section class="sec sec--cream" id="tong-quan">
				<div class="wrap">
					<header class="sec__hd">
						<p class="eyebrow">Vì sao chọn TT GENESIS</p>
						<h2>6 yếu tố <em>gia tăng giá trị</em></h2>
					</header>
					<div class="strengths">
						{strengths.map((s) => (
							<article class="strength">
								<span class="strength__n">{s.n}</span>
								<h3>{s.t}</h3>
								<p>{s.d}</p>
							</article>
						))}
					</div>
					<figure class="wide">
						<img src="/img/aerial-night.webp" alt="Toàn cảnh TT GENESIS về đêm giữa Nam Sài Gòn, bao quanh bởi sông nước" width="1800" height="1012" loading="lazy" />
						<figcaption>3 mặt hướng sông · 4 mặt tiền đường · vận hành chuẩn Compound với 2 lối ra vào riêng biệt</figcaption>
					</figure>
				</div>
			</section>

			<!-- ================= LOCATION ================= -->
			<section class="sec sec--dark" id="vi-tri">
				<div class="wrap">
					<header class="sec__hd">
						<p class="eyebrow">Vị trí chiến lược</p>
						<h2>Một bước chân, <em>ngàn kết nối</em></h2>
						<p class="lead">Mặt tiền đường 30m, KDC Đào Sư Tích, phường Nhà Bè, TP.HCM – tâm điểm “thủ phủ” giáo dục quốc tế Nam Sài Gòn với RMIT, SSIS, LSTS, CIS, ABCIS…</p>
					</header>
					<div class="loc">
						<figure class="loc__map">
							<img src="/img/location-map.webp" alt="Bản đồ vị trí TT GENESIS và các tuyến kết nối Nam Sài Gòn" width="1800" height="1012" loading="lazy" data-zoom />
						</figure>
						<div class="loc__side">
							<ul class="dist">
								{distances.map((d) => (
									<li><strong>{d.v}</strong><span>{d.l}</span></li>
								))}
							</ul>
							<p class="loc__note">Hưởng trọn hệ sinh thái Phú Mỹ Hưng: Crescent Mall, Lotte Mart, SC VivoCity, Cầu Ánh Sao, Art Center, SECC cùng hệ thống bệnh viện và trường quốc tế.</p>
						</div>
					</div>
					<div class="edu">
						<figure class="loc__map">
							<img src="/img/edu-map.webp" alt="Bản đồ hệ thống trường quốc tế quanh TT GENESIS" width="946" height="797" loading="lazy" data-zoom />
						</figure>
						<div>
							<h3 class="sub sub--left">Toạ độ vun bồi tri thức</h3>
							<p class="loc__note">Bao quanh dự án là mạng lưới trường học danh tiếng – nền tảng cho cộng đồng cư dân tri thức và nguồn khách thuê chuyên gia ổn định:</p>
							<ul class="chips">
								<li>ĐH RMIT</li><li>ĐH Tôn Đức Thắng</li><li>SSIS – Saigon South</li><li>CIS – Canadian</li><li>ABCIS</li><li>Lawrence S. Ting</li><li>Singapore Int’l School</li><li>Japanese Int’l School</li><li>Korean Int’l School</li><li>Taipei School</li><li>VStar School · VFI School</li>
							</ul>
						</div>
					</div>
					<h3 class="sub">Hạ tầng tỷ đô quanh dự án</h3>
					<div class="infra">
						{infra.map((i) => (
							<div class="infra__it">
								<b>{i.t}</b>
								<span>{i.d}</span>
							</div>
						))}
					</div>
					<p class="fine">Thông tin quy hoạch, tiến độ hạ tầng mang tính tham khảo theo công bố tại thời điểm tháng 9/2026.</p>
				</div>
			</section>

			<!-- ================= AMENITIES ================= -->
			<section class="sec sec--cream" id="tien-ich">
				<div class="wrap">
					<header class="sec__hd">
						<p class="eyebrow">Compound Resort đa thế hệ</p>
						<h2>88 tiện ích nuôi dưỡng <em>Thân – Tâm – Trí</em></h2>
						<p class="lead">Hơn 8.000 m² tiện ích ngoài trời và 2.800 m² tiện ích trong nhà – từ học tập đến vận động, từ kết nối đến tĩnh tại, mỗi thành viên đều có khoảng không của riêng mình.</p>
					</header>
					<figure class="wide">
						<img src="/img/amenity-night.webp" alt="Toàn cảnh hệ tiện ích nội khu TT GENESIS với kim tự tháp trung tâm và hồ bơi" width="1600" height="900" loading="lazy" />
						<figcaption>Toạ độ trung tâm PYRAMID (~836 m²) – biểu tượng tri thức giữa lòng nội khu</figcaption>
					</figure>
					<div class="zones">
						{zones.map((z) => (
							<article class="zone">
								<img src={`/img/${z.img}.webp`} alt={`${z.t} – ${z.s}`} loading="lazy" width="700" height="394" data-zoom />
								<div class="zone__tx">
									<h3>{z.t}</h3>
									<p class="zone__s">{z.s}</p>
									<p>{z.d}</p>
								</div>
							</article>
						))}
					</div>
					<div class="center">
						<a href="#dang-ky" class="btn btn--navy btn--lg" data-track="cta_amenities">Đặt lịch tham quan WOW Center</a>
					</div>
				</div>
			</section>

			<!-- ================= APARTMENTS ================= -->
			<section class="sec sec--dark" id="can-ho">
				<div class="wrap">
					<header class="sec__hd">
						<p class="eyebrow">Thiết kế căn hộ</p>
						<h2>Khi con người <em>kết nối với thiên nhiên</em></h2>
						<p class="lead">Thiết kế bởi TWOG: 100% phòng khách và phòng ngủ nhìn trực diện bên ngoài, 100% căn hộ có ban công và sân phơi, tỷ lệ vàng 6 thang máy cho 12–13 căn mỗi tầng.</p>
					</header>
					<div class="tabs" data-tabs>
						<div class="tabs__bar" role="tablist" aria-label="Loại căn hộ">
							{plans.map((p, i) => (
								<button role="tab" type="button" id={`tab-${p.id}`} aria-controls={`pn-${p.id}`} aria-selected={i === 2 ? "true" : "false"} tabindex={i === 2 ? 0 : -1}>{p.tab}</button>
							))}
						</div>
						{plans.map((p, i) => (
							<div class="plan" role="tabpanel" id={`pn-${p.id}`} aria-labelledby={`tab-${p.id}`} hidden={i !== 2}>
								<img src={`/img/${p.img}.webp`} alt={`Mặt bằng căn hộ ${p.name}`} width="1400" height="787" loading="lazy" data-zoom />
								<div class="plan__info">
									<h3>{p.name}</h3>
									<dl>
										<div><dt>Diện tích tim tường</dt><dd>{p.tt}</dd></div>
										<div><dt>Diện tích thông thuỷ</dt><dd>{p.lt}</dd></div>
									</dl>
									<p>{p.note}</p>
									<a href="#dang-ky" class="btn btn--gold" data-track={`cta_plan_${p.id}`} data-interest={p.tab}>Xem giá căn {p.tab}</a>
								</div>
							</div>
						))}
					</div>
					<div class="mix">
						<div><b>1.363</b><span>Căn hộ (tầng 3–30)</span></div>
						<div><b>42</b><span>Căn Duplex khối đế</span></div>
						<div><b>12</b><span>Căn hộ sân vườn</span></div>
						<div><b>9</b><span>Penthouse</span></div>
						<div><b>12</b><span>Nhà liên kế</span></div>
					</div>
					<p class="fine">Hình ảnh minh hoạ, đồ nội thất chỉ mang tính chất tham khảo. Thông số bàn giao theo hợp đồng.</p>
				</div>
			</section>

			<!-- ================= HANDOVER ================= -->
			<section class="sec sec--cream" id="ban-giao">
				<div class="wrap split">
					<div>
						<p class="eyebrow">Chuẩn bàn giao</p>
						<h2>Thương hiệu <em>Nhật Bản, Châu Âu & Mỹ</em></h2>
						<ul class="ticks">
							<li>Thiết bị vệ sinh TOTO, Grohe · thiết bị điện Panasonic, Hager</li>
							<li>Khoá điện tử vân tay Yale · phụ kiện Hafele · gỗ An Cường · sơn Jotun</li>
							<li>Kính Low-E cách nhiệt, hệ thống nước uống tại vòi</li>
							<li>Face ID tại sảnh, Intercom App, thang máy 2,5 m/s dùng thẻ từ</li>
							<li>Wifi miễn phí khu công cộng · hơn 5.000 m² đậu ô tô bổ sung tại hầm</li>
							<li>Công trình theo tiêu chuẩn xanh EDGE</li>
						</ul>
					</div>
					<figure>
						<img src="/img/interior.webp" alt="Phòng khách căn hộ TT GENESIS với ban công nhìn trực diện ra bên ngoài" width="1400" height="538" loading="lazy" />
					</figure>
				</div>
			</section>

			<!-- ================= PAYMENT ================= -->
			<section class="sec sec--dark" id="thanh-toan">
				<div class="wrap">
					<header class="sec__hd">
						<p class="eyebrow">Phương thức thanh toán</p>
						<h2>Chọn lộ trình <em>vừa với dòng tiền</em> của bạn</h2>
					</header>
					<div class="tabs" data-tabs>
						<div class="tabs__bar" role="tablist" aria-label="Phương thức thanh toán">
							{payments.map((p, i) => (
								<button role="tab" type="button" id={`tab-${p.id}`} aria-controls={`pn-${p.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>{p.tab}</button>
							))}
						</div>
						{payments.map((p, i) => (
							<div class="pay" role="tabpanel" id={`pn-${p.id}`} aria-labelledby={`tab-${p.id}`} hidden={i !== 0}>
								<div class="pay__hl">
									<strong>{p.hl}</strong>
									<span>{p.sub}</span>
								</div>
								<ol class="pay__steps">
									{p.steps.map(([a, b]) => (
										<li><b>{a}</b><span>{b}</span></li>
									))}
								</ol>
							</div>
						))}
					</div>
					<div class="banks">
						<span>Ngân hàng đồng hành:</span>
						<b>VPBank</b><b>VietinBank</b><b>Vietcombank</b><b>ACB</b><b>MBBank</b>
					</div>
					<p class="fine">(*) Lịch thanh toán tóm tắt theo tài liệu chính sách Đợt 1; chi tiết theo thông báo chính sách do chủ đầu tư ban hành.</p>
					<div class="center">
						<a href="#dang-ky" class="btn btn--gold btn--lg" data-track="cta_payment">Nhận bảng tính dòng tiền theo căn</a>
					</div>
				</div>
			</section>

			<!-- ================= PARTNERS ================= -->
			<section class="sec sec--cream" id="doi-tac">
				<div class="wrap">
					<header class="sec__hd">
						<p class="eyebrow">Liên doanh phát triển dự án</p>
						<h2>Kiến tạo các <em>giá trị bền vững</em></h2>
					</header>
					<figure class="wide jv"><img src="/img/jv-signing.webp" alt="Lễ ký kết liên doanh phát triển dự án TT GENESIS" width="1400" height="788" loading="lazy" /><figcaption>Lễ ký kết liên doanh Việt Nam – Nhật Bản – Singapore</figcaption></figure>
					<ul class="plogos" aria-label="Liên doanh đầu tư và phát triển dự án">
						{partnerLogos.map((l) => (
							<li><img src={`/img/partners/${l.f}.webp`} alt={l.n} width={l.w} height={l.h} style={`--h:${l.dh}px`} loading="lazy" /></li>
						))}
					</ul>
					<div class="partners">
						{partners.map((p) => (
							<article class="partner">
								<span>{p.c}</span>
								<h3>{p.n}</h3>
								<p>{p.d}</p>
							</article>
						))}
					</div>
					<div class="consult">
						{consultants.map(([k, v]) => (
							<div><span>{k}</span><b>{v}</b></div>
						))}
					</div>
				</div>
			</section>

			<!-- ================= LEGAL + TIMELINE ================= -->
			<section class="sec sec--dark" id="phap-ly">
				<div class="wrap split split--top">
					<div>
						<p class="eyebrow">Pháp lý minh bạch</p>
						<h2>Hồ sơ <em>đầy đủ</em></h2>
						<ul class="legal">
							{legal.map(([d, t]) => (
								<li><time>{d}</time><span>{t}</span></li>
							))}
						</ul>
						<p class="loc__note">Chủ đầu tư: Công ty CP Bất động sản Phúc Long – Phước Kiển · Ngân hàng bảo lãnh: VPBank.</p>
					</div>
					<div>
						<p class="eyebrow">Tiến độ</p>
						<h2>Lộ trình <em>dự kiến</em></h2>
						<ol class="tl">
							{timeline.map(([d, t]) => (
								<li><b>{d}</b><span>{t}</span></li>
							))}
						</ol>
					</div>
				</div>
			</section>

			<!-- ================= FAQ ================= -->
			<section class="sec sec--cream" id="faq">
				<div class="wrap wrap--narrow">
					<header class="sec__hd">
						<p class="eyebrow">Hỏi đáp</p>
						<h2>Câu hỏi <em>thường gặp</em></h2>
					</header>
					<div class="faq">
						{faqs.map((f, i) => (
							<details open={i === 0}>
								<summary>{f.q}</summary>
								<p>{f.a}</p>
							</details>
						))}
					</div>
				</div>
			</section>

			<!-- ================= FINAL CTA ================= -->
			<section class="final" id="dang-ky">
				<img class="final__bg" src="/img/amenity-oasis.webp" alt="" width="1400" height="788" loading="lazy" />
				<div class="wrap final__in">
					<div class="final__copy">
						<p class="eyebrow">Đăng ký tư vấn 1:1</p>
						<h2>Nhận bảng giá, mặt bằng & <em>chính sách Đợt 1</em></h2>
						<ul class="ticks ticks--light">
							<li>Bảng giá chi tiết từng căn – cập nhật trong ngày</li>
							<li>Bảng tính dòng tiền theo phương thức bạn chọn</li>
							<li>Đặt lịch tham quan WOW Center & nhà mẫu</li>
						</ul>
						<div class="final__contact">
							<a href={telHref} class="btn btn--gold btn--lg" data-track="call_final">Gọi {CONTACT.phoneDisplay}</a>
							<a href={zaloHref} target="_blank" rel="noopener" class="btn btn--ghost btn--lg" data-track="zalo_final">Chat Zalo tư vấn</a>
						</div>
					</div>
					<LeadForm id="final" title="Đăng ký nhận thông tin" subtitle="Miễn phí, không ràng buộc. Bạn chọn cách nhận – qua Zalo hoặc điện thoại." cta="Đăng ký ngay" />
				</div>
			</section>
		</main>

		<!-- ================= FOOTER ================= -->
		<footer class="ft">
			<div class="wrap ft__grid">
				<div>
					<img src="/img/logo-white.png" alt="TT GENESIS" width="156" height="40" loading="lazy" />
					<p>Căn hộ Tri thức Nhật Bản tại Nam Sài Gòn.<br />Mặt tiền đường 30m, KDC Đào Sư Tích, phường Nhà Bè, TP.HCM.</p>
				</div>
				<div>
					<h4>Đơn vị tư vấn & phân phối</h4>
					<p>
						<b>{CONTACT.company}</b><br />
						MST: {CONTACT.taxCode}<br />
						{CONTACT.address}
					</p>
				</div>
				<div>
					<h4>Liên hệ</h4>
					<p>
						Hotline/Zalo: <a href={telHref} data-track="call_footer">{CONTACT.phoneDisplay}</a> ({CONTACT.advisor})<br />
						Email: <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
					</p>
				</div>
			</div>
			<div class="wrap ft__legal">
				<p>
					Trang thông tin do {CONTACT.companyShort} – đơn vị tư vấn, phân phối – thực hiện; không phải website chính thức của chủ đầu tư.
					Thông tin, hình ảnh, giá bán và chính sách trên trang mang tính tham khảo, được tổng hợp từ tài liệu của đơn vị phát triển dự án và có thể thay đổi theo từng thời điểm
					mà không cần báo trước; nội dung chính thức căn cứ theo hợp đồng và văn bản do chủ đầu tư ban hành. Hình ảnh phối cảnh chỉ mang tính minh hoạ.
				</p>
				<p>Thông tin cá nhân bạn cung cấp chỉ được dùng để tư vấn về dự án TT GENESIS và không chia sẻ cho bên thứ ba.</p>
				<p><a href="/chinh-sach-bao-mat">Chính sách bảo mật thông tin</a> · © 2026 {CONTACT.companyShort}.</p>
			</div>
		</footer>

		<!-- ================= STICKY MOBILE BAR ================= -->
		<div class="mbar" role="navigation" aria-label="Liên hệ nhanh">
			<a href={telHref} data-track="call_sticky">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg>
				Gọi ngay
			</a>
			<a href={zaloHref} target="_blank" rel="noopener" data-track="zalo_sticky">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3C6.5 3 2 6.8 2 11.5c0 2.6 1.4 5 3.6 6.5L5 21l3.6-1.6c1 .3 2.2.6 3.4.6 5.5 0 10-3.8 10-8.5S17.500 3 12 3z"/></svg>
				Zalo
			</a>
			<a href="#dang-ky" class="mbar__main" data-track="cta_sticky">Nhận bảng giá</a>
		</div>

		<!-- Floating buttons (desktop) -->
		<div class="fab">
			<a href={zaloHref} target="_blank" rel="noopener" class="fab__z" aria-label="Chat Zalo" data-track="zalo_fab">Zalo</a>
			<a href={telHref} class="fab__c" aria-label={`Gọi ${CONTACT.phoneDisplay}`} data-track="call_fab">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg>
			</a>
		</div>

		<!-- Lightbox -->
		<div class="lb" hidden>
			<button type="button" class="lb__x" aria-label="Đóng">×</button>
			<img alt="" />
		</div>

		<script is:inline define:vars={{ webhookUrl: LEAD.webhookUrl, zaloHref }}>
			(function () {
				var $ = function (s, r) { return Array.prototype.slice.call((r || document).querySelectorAll(s)); };

				/* ---- tracking helper: đẩy sự kiện tới mọi pixel đã cài ---- */
				function track(name, data) {
					try {
						window.dataLayer = window.dataLayer || [];
						window.dataLayer.push(Object.assign({ event: name }, data || {}));
						if (window.gtag) window.gtag("event", name, data || {});
						if (name === "generate_lead") {
							if (window.fbq) window.fbq("track", "Lead");
							if (window.ttq) window.ttq.track("SubmitForm");
						} else if (/^call_|^zalo_/.test(name)) {
							if (window.fbq) window.fbq("track", "Contact");
							if (window.ttq) window.ttq.track("Contact");
						}
					} catch (e) {}
				}
				document.addEventListener("click", function (e) {
					var a = e.target.closest("[data-track]");
					if (!a) return;
					track(a.getAttribute("data-track"));
					var it = a.getAttribute("data-interest");
					if (it) $("select[name=interest]").forEach(function (s) {
						for (var i = 0; i < s.options.length; i++) if (s.options[i].value.indexOf(it.split(" ")[0]) === 0) s.selectedIndex = i;
					});
				});

				/* ---- header shadow ---- */
				var hd = document.querySelector(".hd");
				var onScroll = function () { hd.classList.toggle("is-stuck", window.scrollY > 24); };
				window.addEventListener("scroll", onScroll, { passive: true }); onScroll();

				/* ---- tự ẩn ưu đãi đã hết hạn (tránh vi phạm "ưu đãi không còn hiệu lực") ---- */
				var now = Date.now();
				$("[data-expires]").forEach(function (el) { var t = Date.parse(el.getAttribute("data-expires")); if (t && now > t) el.hidden = true; });
				$("[data-show-after]").forEach(function (el) { var t = Date.parse(el.getAttribute("data-show-after")); if (t && now > t) el.hidden = false; });

				/* ---- countdown ---- */
				$(".countdown").forEach(function (el) {
					var end = new Date(el.getAttribute("data-deadline")).getTime();
					function tick() {
						var t = Math.max(0, end - Date.now());
						if (t === 0) { el.closest(".sec__hd").classList.add("cd-ended"); return; }
						var v = { d: Math.floor(t / 864e5), h: Math.floor(t / 36e5) % 24, m: Math.floor(t / 6e4) % 60, s: Math.floor(t / 1e3) % 60 };
						Object.keys(v).forEach(function (k) { el.querySelector("[data-cd=" + k + "]").textContent = (v[k] < 10 ? "0" : "") + v[k]; });
						setTimeout(tick, 1000);
					}
					tick();
				});

				/* ---- tabs ---- */
				$("[data-tabs]").forEach(function (root) {
					var tabs = $("[role=tab]", root);
					function select(tab) {
						tabs.forEach(function (t) {
							var on = t === tab;
							t.setAttribute("aria-selected", on ? "true" : "false");
							t.tabIndex = on ? 0 : -1;
							document.getElementById(t.getAttribute("aria-controls")).hidden = !on;
						});
					}
					tabs.forEach(function (t, i) {
						t.addEventListener("click", function () { select(t); track("tab_" + t.id.replace("tab-", "")); });
						t.addEventListener("keydown", function (e) {
							var d = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
							if (!d) return;
							var n = tabs[(i + d + tabs.length) % tabs.length]; n.focus(); select(n);
						});
					});
				});

				/* ---- lightbox ---- */
				var lb = document.querySelector(".lb"), lbImg = lb.querySelector("img");
				$("[data-zoom]").forEach(function (im) {
					im.addEventListener("click", function () { lbImg.src = im.currentSrc || im.src; lbImg.alt = im.alt; lb.hidden = false; });
				});
				function closeLb() { lb.hidden = true; lbImg.removeAttribute("src"); }
				lb.addEventListener("click", closeLb);
				document.addEventListener("keydown", function (e) { if (e.key === "Escape" && !lb.hidden) closeLb(); });

				/* ---- lead forms ---- */
				var qs = new URLSearchParams(location.search);
				var utmKeys = ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term", "fbclid", "gclid", "ttclid"];
				try {
					var saved = JSON.parse(sessionStorage.getItem("utm") || "{}");
					utmKeys.forEach(function (k) { if (qs.get(k)) saved[k] = qs.get(k); });
					sessionStorage.setItem("utm", JSON.stringify(saved));
				} catch (e) { var saved = {}; utmKeys.forEach(function (k) { if (qs.get(k)) saved[k] = qs.get(k); }); }

				$("form[data-lead]").forEach(function (form) {
					var msg = form.querySelector(".lf__msg"), btn = form.querySelector("button[type=submit]");
					form.addEventListener("submit", function (e) {
						e.preventDefault();
						if (form.website.value) return; // honeypot
						var name = form.fullname.value.trim();
						var phone = form.phone.value.replace(/[\s.\-()]/g, "").replace(/^\+?84/, "0");
						if (name.length < 2) { return fail("Vui lòng nhập họ tên của bạn.", form.fullname); }
						if (!/^0(3|5|7|8|9)\d{8}$/.test(phone)) { return fail("Số điện thoại chưa đúng, vui lòng kiểm tra lại.", form.phone); }
						var data = new URLSearchParams();
						data.set("name", name); data.set("phone", phone);
						data.set("interest", form.interest.value);
						data.set("contact_pref", form.contact_pref.value);
						data.set("form", form.getAttribute("data-lead"));
						data.set("page", location.href.split("#")[0]);
						data.set("time", new Date().toLocaleString("vi-VN", { timeZone: "Asia/Ho_Chi_Minh" }));
						utmKeys.forEach(function (k) { data.set(k, saved[k] || ""); });
						btn.disabled = true; btn.dataset.label = btn.textContent; btn.textContent = "Đang gửi…";
						msg.className = "lf__msg"; msg.textContent = "";

						if (!webhookUrl) {
							// Chưa cấu hình Google Sheet: chuyển khách sang Zalo để không mất lead
							track("generate_lead", { form_id: form.getAttribute("data-lead"), method: "zalo_fallback" });
							done("Cảm ơn " + name + "! Đang mở Zalo để chuyên viên gửi bảng giá cho bạn…");
							setTimeout(function () { window.open(zaloHref, "_blank"); }, 900);
							return;
						}
						fetch(webhookUrl, { method: "POST", mode: "no-cors", body: data })
							.then(function () {
								track("generate_lead", { form_id: form.getAttribute("data-lead"), interest: form.interest.value });
								done("Đăng ký thành công! Chuyên viên sẽ liên hệ " + phone + " sớm nhất.");
							})
							.catch(function () {
								btn.disabled = false; btn.textContent = btn.dataset.label;
								msg.className = "lf__msg is-err";
								msg.textContent = "Chưa gửi được do lỗi mạng. Vui lòng thử lại hoặc gọi hotline.";
							});
					});
					function fail(t, el) { msg.className = "lf__msg is-err"; msg.textContent = t; el.focus(); }
					function done(t) {
						form.classList.add("is-done");
						msg.className = "lf__msg is-ok"; msg.textContent = t;
						btn.textContent = "Đã gửi ✓";
					}
				});
			})();
		</script>
		{
			TRACKING.gtmId && (
				<noscript>
					<iframe src={`https://www.googletagmanager.com/ns.html?id=${TRACKING.gtmId}`} height="0" width="0" style="display:none;visibility:hidden" />
				</noscript>
			)
		}
	</body>
</html>
